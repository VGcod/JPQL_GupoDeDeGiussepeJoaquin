<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="FacturacionPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>org.example.entities.Usuario</class>
        <class>org.example.entities.PuntoVenta</class>
        <class>org.example.entities.TipoMoneda</class>
        <class>org.example.entities.CondicionIva</class>
        <class>org.example.entities.Cliente</class>
        <class>org.example.entities.Contacto</class>
        <class>org.example.entities.Domicilio</class>
        <class>org.example.entities.Rubro</class>
        <class>org.example.entities.Marca</class>
        <class>org.example.entities.Articulo</class>
        <class>org.example.entities.ListaPrecio</class>
        <class>org.example.entities.ListaPrecioArticulo</class>
        <class>org.example.entities.FacturaVenta</class>
        <class>org.example.entities.FacturaVentaDetalle</class>

        <properties>
            <!-- Conexión a Base de Datos (Ejemplo PostgreSQL) -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/factura-arca"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="193055Nelva"/>

            <!-- Configuración Hibernate -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="create"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>